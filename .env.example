POSTGRES_USER=ownocr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ownocr

# Host port that nginx listens on in production.
APP_PORT=8080

# River worker goroutines per backend instance. Ingest runs on its own queue
# with one worker regardless of this value.
WORKERS=4

# WebSocket origin allowlist. "*" accepts any origin.
# Production must list real hosts, for example: ownocr.example.com
ALLOWED_ORIGINS=*

# Root of the file store inside the containers. The book_data volume mounts
# here: read-write in the backend, read-only in the frontend.
DATA_DIR=/data

# Total upload body limit in bytes. Default is 2 GiB. Raise nginx
# client_max_body_size to match if you raise this.
MAX_UPLOAD_BYTES=2147483648

# Resolution pdftoppm renders PDF pages at. 300 is the floor for reliable OCR.
# A 500 page book at 300 DPI uses roughly 3 GB of disk.
PDF_DPI=300

# S3 or an S3 compatible store to send data to the GPU.
# Leave AWS_ENDPOINT_URL empty for real AWS.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# The RunPod endpoint built from runpod/dewarp. The URL is the endpoint base,
# for example https://api.runpod.ai/v2/<endpoint-id>.
DEWARP_API_URL=
DEWARP_API_TOKEN=

# The RunPod endpoint built from runpod/paddleocr, in the same form.
PADDLEOCR_VL_API_URL=
PADDLEOCR_VL_API_TOKEN=

# The OpenRouter key the Ultra rescan reads pages with, on GLM-5.3 Flash.
OPENROUTER_API_KEY=
