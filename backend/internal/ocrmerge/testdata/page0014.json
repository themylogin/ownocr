: [[67.0, 1998.0], [1276.0, 1998.0], [1276.0, 2077.0], [67.0, 2077.0]], "score": 0.9406976103782654}, {"cls_id": 16, "coordinate": [1235, 2144, 1280, 2182], "label": "number", "order": 9, "polygon_points": [[1235.0, 2144.0], [1280.0, 2144.0], [1280.0, 2182.0], [1235.0, 2182.0]], "score": 0.7838774919509888}], "input_path": null, "page_index": null}, "model_settings": {"format_block_content": false, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "merge_layout_blocks": true, "return_layout_polygon_points": true, "use_chart_recognition": false, "use_doc_preprocessor": false, "use_layout_detection": true, "use_ocr_for_image_block": false, "use_seal_recognition": false}, "page_count": null, "page_index": null, "parsing_res_list": [{"block_bbox": [94, 228, 1298, 385], "block_content": "y no de que haya en general cosas reconocibles como bellas, sino de que la belleza se manifieste como tal únicamente a su propia luz.", "block_id": 0, "block_label": "text", "block_order": 1, "block_polygon_points": [[94.0, 228.0], [1298.0, 228.0], [1298.0, 385.0], [94.0, 385.0]], "group_id": 0}, {"block_bbox": [88, 492, 1042, 542], "block_content": "II. HERÁCLITO: τὸ σοφόν Υ φιλόσοφοι ἄνδρες", "block_id": 1, "block_label": "paragraph_title", "block_order": 2, "block_polygon_points": [[88.0, 492.0], [1042.0, 492.0], [1042.0, 542.0], [88.0, 542.0]], "group_id": 1}, {"block_bbox": [86, 600, 1297, 968], "block_content": "En todo lo hasta aquí visto, σοφοός aparece como un adjetivo y σοφία como el abstracto de ese adjetivo, designando ambos una cualidad posible del hombre. Ello en el sentido siguiente: es del hombre de quien se discute si él es o no es σοφοός; la referencia que hemos registrado a «los dioses» no hace más que confirmar esto, pues, a fin de cuentas, da por supuesto que un dios no es algo de lo que se discuta si es σοφοός o no.", "block_id": 2, "block_label": "text", "block_order": 3, "block_polygon_points": [[86.0, 600.0], [1297.0, 600.0], [1297.0, 968.0], [86.0, 968.0]], "group_id": 2}, {"block_bbox": [83, 974, 1291, 1124], "block_content": "Hay, sin embargo, algunos textos griegos arcaicos, importantes en la historia de la filosofía, que no se conforman con ese esquema.", "block_id": 3, "block_label": "text", "block_order": 4, "block_polygon_points": [[83.0, 974.0], [1291.0, 974.0], [1291.0, 1124.0], [83.0, 1124.0]], "group_id": 3}, {"block_bbox": [144, 1129, 842, 1177], "block_content": "Así, por una parte, Heráclito, B 32:", "block_id": 4, "block_label": "text", "block_order": 5, "block_polygon_points": [[144.0, 1129.0], [842.0, 1129.0], [842.0, 1177.0], [144.0, 1177.0]], "group_id": 4}, {"block_bbox": [81, 1182, 1289, 1280], "block_content": "ἐν τὸ σοφὸν μοῦνον λέγεσθαι οὐκ ἐθέλει καὶ ἐθέλει Ζηνὸς\nὁνομα^{7}.", "block_id": 5, "block_label": "text", "block_order": 6, "block_polygon_points": [[81.0, 1182.0], [1289.0, 1182.0], [1289.0, 1280.0], [81.0, 1280.0]], "group_id": 5}, {"block_bbox": [74, 1290, 1291, 1708], "block_content": "Aquí τὸ σοφόν no es ni dios ni hombre alguno; la palabra debe designar algo uno, único y singular; e incluso la referencia a Zeus se hace de manera que excluye tajantemente que σοφός designe una cualidad o atributo del dios; no se dice que Zeus sea ό σοφός, sino que τὸ σοφόν [nótese la diferencia morfológica^{8}] puede en cierta manera ser «dicho» en cuanto que es dicho el nombre de Zeus, si bien, por otra parte, no puede τὸ σοφόν ser dicho así.", "block_id": 6, "block_label": "text", "block_order": 7, "block_polygon_points": [[74.0, 1290.0], [1291.0, 1290.0], [1291.0, 1708.0], [74.0, 1708.0]], "group_id": 6}, {"block_bbox": [135, 1712, 710, 1761], "block_content": "Igualmente, Heráclito, B 108:", "block_id": 7, "block_label": "text", "block_order": 8, "block_polygon_points": [[135.0, 1712.0], [710.0, 1712.0], [710.0, 1761.0], [135.0, 1761.0]], "group_id": 7}, {"block_bbox": [71, 1878, 1275, 1996], "block_content": "7 Diels, H.: Die Fragmente der Vorsokratiker, 6. Auflage, hrsg. von W. Kranz, 1951 (y reimpresiones posteriores de la misma edición, en adelante citado simplemente como «Diels-Kranz»), Herakl. B 32 (t. I, pág. 159).", "block_id": 8, "block_label": "footnote", "block_order": null, "block_polygon_points": [[71.0, 1878.0], [1275.0, 1878.0], [1275.0, 1996.0], [71.0, 1996.0]], "group_id": 8}, {"block_bbox": [67, 1998, 1276, 2077], "block_content": "8 El llamado «neutro singular» es la forma que se emplea para el uso absoluto (sin vinculación atributiva ni predicativa) del adjetivo.", "block_id": 9, "block_label": "footnote", "block_order": null, "block_polygon_points": [[67.0, 1998.0], [1276.0, 1998.0], [1276.0, 2077.0], [67.0, 2077.0]], "group_id": 9}, {"block_bbox": [1235, 2144, 1280, 2182], "block_content": "17", "block_id": 10, "block_label": "number", "block_order": null, "block_polygon_points": [[1235.0, 2144.0], [1280.0, 2144.0], [1280.0, 2182.0], [1235.0, 2182.0]], "group_id": 10}], "width": 1445}
