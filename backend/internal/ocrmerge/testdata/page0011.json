99988079071045, "text": "en"}, {"bbox": [165, 1734, 1354, 1774], "score": 0.997162938117981, "text": "cuestión. No es así, sino que ese «saber» como «entender de»,"}, {"bbox": [1573, 1727, 1608, 1764], "score": 0.999858021736145, "text": "ar"}, {"bbox": [1570, 1765, 1608, 1801], "score": 0.9999024271965027, "text": "se"}, {"bbox": [162, 1785, 1355, 1828], "score": 0.9997132420539856, "text": "capacidad o destreza, es el saber que la lengua griega arcaica"}, {"bbox": [1568, 1803, 1608, 1842], "score": 0.9999957084655762, "text": "de"}, {"bbox": [161, 1839, 1354, 1882], "score": 0.9930906891822815, "text": "reconoce como tal. ¿ Hará falta recordar aquí que la propia pala-"}, {"bbox": [1570, 1843, 1608, 1884], "score": 0.6035928130149841, "text": "co"}, {"bbox": [162, 1891, 1358, 1935], "score": 0.9746617078781128, "text": "bra vóoç (lo que luego sería el voű y finalmente el intellectus)"}, {"bbox": [1568, 1882, 1608, 1923], "score": 0.6038571000099182, "text": "SO"}, {"bbox": [1569, 1924, 1608, 1965], "score": 0.9999732375144958, "text": "pr"}, {"bbox": [1571, 1966, 1608, 2003], "score": 0.999979555606842, "text": "da"}, {"bbox": [1570, 2040, 1608, 2082], "score": 0.969346284866333, "text": "ma"}, {"bbox": [209, 2052, 621, 2086], "score": 0.9718849658966064, "text": "3 Homero (llíada), O 412."}, {"bbox": [160, 2146, 211, 2189], "score": 0.9999764561653137, "text": "14"}], "raw": {"dt_polys": [[[1571, 239], [1608, 239], [1608, 286], [1571, 286]], [[182, 251], [1375, 250], [1375, 293], [182, 294]], [[1571, 292], [1608, 292], [1608, 335], [1571, 335]], [[183, 303], [1377, 303], [1377, 346], [183, 346]], [[180, 356], [1377, 355], [1377, 399], [180, 400]], [[1570, 347], [1608, 347], [1608, 390], [1570, 390]], [[1569, 397], [1608, 397], [1608, 442], [1569, 442]], [[179, 409], [1373, 409], [1373, 452], [179, 452]], [[179, 461], [958, 462], [958, 506], [179, 505]], [[936, 462], [1372, 465], [1372, 506], [936, 503]], [[1572, 501], [1608, 501], [1608, 548], [1572, 548]], [[178,